[sub_resource type="Shader" id="Shader_inanf"]
code = "shader_type spatial;
render_mode unshaded;

uniform sampler2D water_texture;
uniform float scroll_speed = 0.05;

void fragment() {
    vec2 uv = UV;

    uv.x += TIME * scroll_speed;

    vec3 water = texture(water_texture, uv).rgb;

    ALBEDO = water;
}

"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_yhtom"]
render_priority = 0
shader = SubResource("Shader_inanf")
