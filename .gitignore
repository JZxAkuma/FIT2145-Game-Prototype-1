# Godot 4.4 .gitignore

# Godot editor cache/local settings - regenerated automatically, never share
.godot/

# Auto-generated translation files
*.translation

# Import cache (safe to ignore, gets rebuilt; do NOT ignore .import files
# themselves though - those need to be tracked)
.import/

# Export files - uncomment if you don't want export presets/credentials shared
# export_presets.cfg

# Mono/C# specific (if you use C# scripting)
.mono/
data_*/
mono_crash.*.json

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor-specific (if teammates use VSCode etc.)
.vscode/
*.swp

# Build output
export/
builds/
*.pck
*.exe
*.app
*.x86_64
